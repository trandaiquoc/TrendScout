{
  "buildCommand": "python3 scripts/prepare_vercel.py",
  "ignoreCommand": "if git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" \"$VERCEL_GIT_COMMIT_SHA\" -- ':(top)Backend' ':(top)Frontend' 2>/dev/null; then exit 0; else exit 1; fi",
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dashboard/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/keywords", "destination": "/index.html" },
    { "source": "/collections", "destination": "/index.html" },
    { "source": "/collections/:itemId", "destination": "/index.html" },
    { "source": "/products", "destination": "/index.html" },
    { "source": "/trends", "destination": "/index.html" },
    { "source": "/sources", "destination": "/index.html" },
    { "source": "/sources/:itemId", "destination": "/index.html" },
    { "source": "/research", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/runs", "destination": "/index.html" },
    { "source": "/algorithms", "destination": "/index.html" },
    { "source": "/quality", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ],
  "functions": {
    "app/main.py": {
      "maxDuration": 120,
      "excludeFiles": "{tests/**,emulator_tests/**,scripts/**,README.md,requirements-dev.txt}"
    }
  }
}
