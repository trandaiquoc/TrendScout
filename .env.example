# Copy to .env and add server-side provider keys only when approved.
# Never commit the populated file or expose these keys in browser settings.
SERPAPI_API_KEY=
YOUTUBE_API_KEY=

# PostgreSQL runtime credentials; keep both values secret and server-side.
# Both must refer to the same Neon branch and database.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TREND_SCOUT_POSTGRES_RUNTIME_ENABLED=false
TREND_SCOUT_POSTGRES_SCHEMA=trendscout

# AI is disabled by default. STRICT_PRIVATE remains the data-policy default.
OPENROUTER_API_KEY=
TRENDSCOUT_AI_ENABLED=false
TRENDSCOUT_AI_DATA_PROFILE=STRICT_PRIVATE
TRENDSCOUT_AI_COLLECTION_MODEL=particle-ai/particle-1:free
TRENDSCOUT_AI_RECOMMENDATION_MODEL=particle-ai/particle-1:free
TRENDSCOUT_AI_ALLOWED_SOURCES=
TRENDSCOUT_AI_TRANSFER_APPROVED_SOURCES=

# PUBLIC_DEMO is local/test only and requires a separately migrated, server-attested
# ts_test_ai_demo_<hex> schema containing synthetic records only. Never point this
# setting at the primary PostgreSQL schema.
TRENDSCOUT_AI_PUBLIC_DEMO_SCHEMA=
