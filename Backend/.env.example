# Set the real key only in a private local environment file.
OPENROUTER_API_KEY=

# AI remains off until an approved source, free model, and admission policy are configured.
TRENDSCOUT_AI_ENABLED=false
TRENDSCOUT_AI_DATA_PROFILE=PUBLIC_DATA
TRENDSCOUT_AI_COLLECTION_MODEL=
TRENDSCOUT_AI_RECOMMENDATION_MODEL=

# Explicit demo mode for providers that do not report remaining request quota.
# Keeps provider quota UNKNOWN and enforces durable 40/day, 20/min application caps.
# Only valid with PUBLIC_DATA and Wikimedia as the sole allowed and transfer-approved source.
TRENDSCOUT_AI_BOUNDED_UNKNOWN_QUOTA=false

# Comma-separated source IDs reviewed for AI context. YouTube is always denied.
TRENDSCOUT_AI_ALLOWED_SOURCES=

# Separate owner/legal approval for transferring each source to the AI provider.
# This is independent of extraction, derived metrics, and the AI source allowlist.
# Defaults to empty; YouTube remains denied even if configured.
TRENDSCOUT_AI_TRANSFER_APPROVED_SOURCES=
