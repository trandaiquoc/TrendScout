{
  "installCommand": "python3 -m pip install -e '.[legacy-firestore]'",
  "buildCommand": "python3 scripts/prepare_vercel.py",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':(top)Backend' ':(top)Frontend'",
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboard/",
      "permanent": false
    }
  ],
  "functions": {
    "app/main.py": {
      "maxDuration": 120,
      "excludeFiles": "{tests/**,emulator_tests/**,scripts/**,README.md,requirements-dev.txt}"
    }
  }
}
